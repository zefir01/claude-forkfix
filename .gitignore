# Build artifact: the patched runtime tree, regenerated by
# scripts/prepare-patched.sh from the stock install + patches/*.patch (~144 MB).
build/

# Third-party payload, not ours to redistribute: the private bun used to execute
# the patched bundle. Restore with
#   npm pack @oven/bun-linux-x64@1.3.14 && tar xf oven-bun-linux-x64-1.3.14.tgz -C runtime
# The expected sha256 of runtime/package/bin/bun is pinned in manifest.json
# (runtime.bun_sha256); prepare-patched.sh refuses to build if it differs.
runtime/

# Third-party payload: the npm tarball of the pinned Claude Code version, kept
# only as a reference for the installer/version metadata (the JS bundle is not
# in it — it lives in the single-file binary). Restore with
#   npm pack @anthropic-ai/claude-code@2.1.229
upstream/

# Raw experiment streams are deliberately NOT published: they are verbatim
# transcripts of this machine's sessions (local paths, tool output, MCP traffic).
# Everything derived from them that the docs cite -- run.txt, verdict.txt,
# turnN.err, the produced artifacts, the *.meta.json headers -- is committed.
# See docs/EXPERIMENTS.md "Reproducing a run".
docs/experiments/**/*.jsonl
